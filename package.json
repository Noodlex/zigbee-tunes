{
  "name": "zigbee-tunes",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Zigbee Tunes — Z2M Discovery Manager. Normalizes MQTT Discovery payloads between Zigbee2MQTT and Home Assistant.",
  "license": "MIT",
  "author": "Noodlex",
  "homepage": "https://github.com/Noodlex/zigbee-tunes",
  "repository": {
    "type": "git",
    "url": "https://github.com/Noodlex/zigbee-tunes.git"
  },
  "bugs": {
    "url": "https://github.com/Noodlex/zigbee-tunes/issues"
  },
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "start:built": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ui:install": "cd ui && yarn install",
    "ui:dev": "cd ui && yarn dev",
    "ui:build": "cd ui && yarn build",
    "build:all": "yarn build && yarn ui:build"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "mqtt": "^5.16.1",
    "winston": "^3.19.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
